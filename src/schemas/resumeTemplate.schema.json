{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hirevo.app/schemas/resumeTemplate.schema.json",
  "title": "ResumeTemplateDefinition",
  "type": "object",
  "required": ["schemaVersion", "metadata", "page", "theme", "sections"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "metadata": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "thumbnailUrl": { "type": "string" }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["size", "widthPx", "heightPx", "margin"],
      "properties": {
        "size": { "type": "string", "enum": ["A4", "Letter", "Custom"] },
        "widthPx": { "type": "number", "minimum": 1 },
        "heightPx": { "type": "number", "minimum": 1 },
        "margin": { "$ref": "#/$defs/margin" }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["fonts", "colors", "spacing"],
      "properties": {
        "fonts": {
          "type": "object",
          "required": ["heading", "body"],
          "properties": {
            "heading": { "type": "string" },
            "body": { "type": "string" },
            "mono": { "type": "string" }
          },
          "additionalProperties": false
        },
        "colors": {
          "type": "object",
          "required": ["text", "muted", "primary", "secondary", "background"],
          "properties": {
            "text": { "type": "string" },
            "muted": { "type": "string" },
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "background": { "type": "string" },
            "accent": { "type": "string" }
          },
          "additionalProperties": false
        },
        "spacing": {
          "type": "object",
          "required": ["sectionGapPx", "itemGapPx", "lineHeight"],
          "properties": {
            "sectionGapPx": { "type": "number", "minimum": 0 },
            "itemGapPx": { "type": "number", "minimum": 0 },
            "lineHeight": { "type": "number", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "columns": { "type": "integer", "minimum": 1 },
        "columnGapPx": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "margin": {
      "type": "object",
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "type": "number", "minimum": 0 },
        "right": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 },
        "left": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "columns": { "type": "integer", "minimum": 1 },
        "columnGapPx": { "type": "number", "minimum": 0 },
        "paddingPx": { "type": "number", "minimum": 0 },
        "background": { "type": "string" },
        "color": { "type": "string" },
        "font": { "type": "string" },
        "textTransform": { "type": "string", "enum": ["none", "uppercase", "lowercase", "capitalize"] },
        "borderColor": { "type": "string" },
        "borderWidthPx": { "type": "number", "minimum": 0 },
        "borderRadiusPx": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["id", "type", "blocks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["header", "summary", "experience", "education", "skills", "projects", "certifications", "additional", "custom"]
        },
        "label": { "type": "string" },
        "showTitle": { "type": "boolean" },
        "dataKey": { "type": "string" },
        "style": { "$ref": "#/$defs/style" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/richTextBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/listBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/dividerBlock" }
      ]
    },
    "textBlock": {
      "type": "object",
      "required": ["kind", "key"],
      "properties": {
        "kind": { "const": "text" },
        "key": { "type": "string" },
        "variant": { "type": "string", "enum": ["heading", "subheading", "body", "label", "caption"] },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "richTextBlock": {
      "type": "object",
      "required": ["kind", "key"],
      "properties": {
        "kind": { "const": "richText" },
        "key": { "type": "string" },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "required": ["kind", "key"],
      "properties": {
        "kind": { "const": "image" },
        "key": { "type": "string" },
        "shape": { "type": "string", "enum": ["circle", "square", "rounded"] },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "listBlock": {
      "type": "object",
      "required": ["kind", "key", "itemBlocks"],
      "properties": {
        "kind": { "const": "list" },
        "key": { "type": "string" },
        "itemGapPx": { "type": "number", "minimum": 0 },
        "itemBlocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "tableBlock": {
      "type": "object",
      "required": ["kind", "key", "columns"],
      "properties": {
        "kind": { "const": "table" },
        "key": { "type": "string" },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/tableColumn" } },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "tableColumn": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "widthPx": { "type": "number", "minimum": 1 },
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "style": { "$ref": "#/$defs/style" }
      },
      "additionalProperties": false
    },
    "dividerBlock": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "divider" },
        "thicknessPx": { "type": "number", "minimum": 1 },
        "color": { "type": "string" },
        "marginTopPx": { "type": "number", "minimum": 0 },
        "marginBottomPx": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
